# FastAPI service. This is separate from VITE_API_BASE_URL, which still points
# to the legacy Express auth endpoints during the migration.
VITE_FASTAPI_BASE_URL=http://localhost:8000/api/v1

# Browser-safe Supabase settings. A publishable key (or legacy anon key) is
# expected here. Never put a secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
