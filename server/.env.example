APP_NAME=SupportAI API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Copy the PostgreSQL connection string from Supabase Dashboard > Connect.
# Standard postgresql:// strings are adapted to psycopg 3 and sslmode=require.
# Percent-encode reserved characters in the database password before pasting it.
DATABASE_URL=

# Supabase project values; the publishable key is safe for server-to-Auth
# token checks. Never use a secret/service-role key for bearer verification.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Workspace invitation email delivery (SMTP). If SMTP is not configured,
# the API returns a copyable invitation link without sending email.
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_STARTTLS=true
EMAIL_FROM=
